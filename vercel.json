{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!js|css|img|assets|favicon|icon-192|icon-512|apple-touch-icon|og-image|robots|sitemap|ads|google09a9|cf896c|sw|workbox|manifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(js|css|img|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
