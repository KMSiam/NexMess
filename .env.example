# ==============================================================================
# NexMess - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local .env file:
#      cp .env.example .env
# 2. Fill in the required environment variables below with your credentials.
# 3. DO NOT commit your real .env file to Git! It contains confidential keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project:
# Dashboard -> Project Settings -> API (or Project Settings -> Data API):
# - Project URL (e.g., https://xyzcompany.supabase.co)
# - Project API Keys -> "anon" "public" key (JWT token)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Web Push Notifications (OPTIONAL)
# ------------------------------------------------------------------------------
# Used by the browser for background meal reminders and manager notices.
# To generate a new pair of VAPID keys, run:
#   node scripts/generate-vapid-keys.mjs
# Paste the generated public key here:
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ------------------------------------------------------------------------------
# 3. Observability & Telemetry (OPTIONAL - PHASE 1)
# ------------------------------------------------------------------------------
# Sentry Error Monitoring: https://sentry.io/
# Captures client-side unhandled crashes and API errors in production.
VITE_SENTRY_DSN=

# PostHog Product Analytics: https://posthog.com/
# Captures user journeys, route pageviews, and conversion funnels.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 4. Supabase Edge Functions & Secrets (BACKEND ONLY - NOT IN .env)
# ------------------------------------------------------------------------------
# NOTE: The keys below are NOT loaded by Vite into the frontend application.
# Set them in your Supabase Dashboard:
#   Dashboard -> Project Settings -> Edge Functions -> Secrets
#   or via the Supabase CLI (`supabase secrets set KEY=VALUE`):
#
# - GEMINI_API_KEY:
#     Your Google Gemini API Key from https://aistudio.google.com/
#     (Required for the 'market-assistant' Edge Function powered by Gemini 3.6 Flash)
#
# - RESEND_API_KEY:
#     Your Resend API Key from https://resend.com/
#     (Required for the 'send-feedback-email' Edge Function)
#
# - VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT:
#     Your Web Push VAPID credentials (generated from scripts/generate-vapid-keys.mjs)
#     (Required for the 'send-push' Edge Function)
#     Example: VAPID_SUBJECT=mailto:support@nexmess.shop
# ------------------------------------------------------------------------------
